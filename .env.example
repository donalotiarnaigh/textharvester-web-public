# Copy to .env and fill in. See docs/CONFIG.md for the config.json equivalents.
#
# Every variable here is read by the application; the whole set was previously
# undocumented, so eight of them appeared in no reference at all. (See
# docs/CONFIG.md for config.json keys, which these override.)

PORT=3000

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------

# Default provider when a request does not name one.
# One of: openai | anthropic | gemini | mistral
AI_PROVIDER=openai

# API keys — at least one is required, for the provider(s) you intend to use.
# Names must match exactly: the Gemini key is GEMINI_API_KEY, not GOOGLE_API_KEY.
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...
MISTRAL_API_KEY=...

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown)
# ---------------------------------------------------------------------------

# SQLite database location.
# Default: ./data/memorials.db
# DB_PATH=./data/memorials.db

# Directory for burial register CSV output.
# Default: config.json burialRegister.outputDir (./data/burial_register)
# BURIAL_REGISTER_OUTPUT_DIR=./data/burial_register

# Concurrent uploads processed at once.
# Default: config.json upload.maxConcurrent (3)
# UPLOAD_MAX_CONCURRENT=3

# Debug image capture. Both default to true; set to the literal string "false"
# to disable. debug_images can grow large quickly (hundreds of MB).
# DEBUG_IMAGE_PROCESSING=true
# SAVE_DEBUG_IMAGES=true

# Logging verbosity. Both default to false.
# VERBOSE_LOGGING=false
# LOG_TO_STDERR=false
