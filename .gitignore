# Claude Code local state (worktrees, settings, locks).
# This was previously covered only by a machine-local global gitignore, so
# .claude/settings.local.json showed up as untracked on every other clone.
.claude/

# Python virtualenv
venv/
pyvenv.cfg

# Local dev scripts
scripts/ralph/

# Eval reports (generated output)
eval/reports/

# Real ground truth (client data — not for public repo).
# Kept local only; see eval/README.md. CI and contributors use the tracked
# synthetic fixtures in eval/fixtures/synthetic/ instead.
eval/ground-truth/

# Eval source images (client data — not for public repo)
eval/source-images/

# ---------------------------------------------------------------------------
# Accidental-commit guards
#
# The 2026-09 history rewrite was needed because a 56 MB backup tarball, a
# 49 MB burial-register scan and a client CSV were committed by accident. These
# rules block the same shapes from being staged again. Use `git add -f <path>`
# when a fixture genuinely needs to be tracked.
# ---------------------------------------------------------------------------

# Archives
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Register/card scans. Nothing tracked in this repo needs to be a PDF, and the
# working tree fills with them during normal use (uploads/, sample_data/,
# test-data/), so ignoring them is the cheapest way to avoid a repeat.
*.pdf
*.PDF

# Database backups written to the repo root by src/utils/database.js
backups/

# Scratch test scaffold created by docs/test-data-setup.md
test-data/

# Generated public-mirror export (see scripts/export-public-mirror.js)
.mirror-export/
